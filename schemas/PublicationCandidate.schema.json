{
  "$defs": {
    "Platform": {
      "enum": [
        "youtube",
        "tiktok"
      ],
      "title": "Platform",
      "type": "string"
    },
    "Privacy": {
      "enum": [
        "private",
        "unlisted",
        "public"
      ],
      "title": "Privacy",
      "type": "string"
    },
    "Publication": {
      "additionalProperties": false,
      "properties": {
        "contains_synthetic_media": {
          "title": "Contains Synthetic Media",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "is_aigc": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "TikTok AIGC flag; None on YouTube",
          "title": "Is Aigc"
        },
        "localizations": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Localizations",
          "type": "object"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "privacy": {
          "$ref": "#/$defs/Privacy",
          "default": "private"
        },
        "publish_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publish At"
        },
        "render_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Render Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "render_key",
        "title",
        "contains_synthetic_media"
      ],
      "title": "Publication",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the publication gates judge: this exact publication of this exact video (ADR-001 decision 8).\n\nThe compliance verdict and G2 are bound to the hash of this object. It carries the render's key, every\nfield the platform will show (title, description, privacy, disclosure flags, localisations), the channel\nand the run: a changed title, a switched-off disclosure, another render or another video is another hash,\nhence a new decision.",
  "properties": {
    "channel_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Channel Id",
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/Publication"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "channel_id",
    "publication"
  ],
  "title": "PublicationCandidate",
  "type": "object"
}
