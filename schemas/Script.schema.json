{
  "$defs": {
    "AIDisclosure": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "reason"
      ],
      "title": "AIDisclosure",
      "type": "object"
    },
    "AvatarMode": {
      "enum": [
        "off_screen",
        "facing_camera",
        "character_in_scene"
      ],
      "title": "AvatarMode",
      "type": "string"
    },
    "ControlBlock": {
      "additionalProperties": false,
      "properties": {
        "blocking_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "facts_to_verify": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Facts To Verify",
          "type": "array"
        },
        "idea_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idea Score"
        },
        "publishable": {
          "title": "Publishable",
          "type": "boolean"
        }
      },
      "required": [
        "publishable"
      ],
      "title": "ControlBlock",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "avatar": {
          "$ref": "#/$defs/AvatarMode",
          "default": "off_screen"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "id": {
          "pattern": "^S\\d{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "loops": {
          "$ref": "#/$defs/SceneLoops",
          "default": {
            "closes": [],
            "opens": []
          }
        },
        "on_screen_text": {
          "default": "",
          "title": "On Screen Text",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SceneRole"
        },
        "sound": {
          "default": "",
          "title": "Sound",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "tone": {
          "default": "",
          "title": "Tone",
          "type": "string"
        },
        "translation_note": {
          "default": "",
          "title": "Translation Note",
          "type": "string"
        },
        "visual": {
          "default": "",
          "title": "Visual",
          "type": "string"
        },
        "visual_prompt_en": {
          "default": "",
          "title": "Visual Prompt En",
          "type": "string"
        },
        "voice_over": {
          "default": "",
          "title": "Voice Over",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "start_s",
        "duration_s"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneLoops": {
      "additionalProperties": false,
      "properties": {
        "closes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Closes",
          "type": "array"
        },
        "opens": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Opens",
          "type": "array"
        }
      },
      "title": "SceneLoops",
      "type": "object"
    },
    "SceneRole": {
      "description": "Roles of the scenariste-youtube scene JSON (v1.0), mapped to English identifiers.",
      "enum": [
        "hook",
        "setup",
        "relaunch",
        "content",
        "payoff",
        "cta",
        "loop"
      ],
      "title": "SceneRole",
      "type": "string"
    },
    "VideoFormat": {
      "enum": [
        "long",
        "short"
      ],
      "title": "VideoFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "control": {
      "$ref": "#/$defs/ControlBlock"
    },
    "disclosure": {
      "$ref": "#/$defs/AIDisclosure"
    },
    "extras": {
      "additionalProperties": true,
      "description": "source fields kept verbatim for lossless mapping",
      "title": "Extras",
      "type": "object"
    },
    "first_frame": {
      "default": "",
      "title": "First Frame",
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/VideoFormat"
    },
    "idea_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Idea Id",
      "type": "string"
    },
    "language": {
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "title": "Language",
      "type": "string"
    },
    "next_video": {
      "default": "",
      "title": "Next Video",
      "type": "string"
    },
    "promise": {
      "minLength": 1,
      "title": "Promise",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "title_en": {
      "default": "",
      "title": "Title En",
      "type": "string"
    },
    "titles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Titles",
      "type": "array"
    },
    "words_per_minute": {
      "exclusiveMinimum": 0,
      "title": "Words Per Minute",
      "type": "number"
    }
  },
  "required": [
    "idea_id",
    "format",
    "language",
    "words_per_minute",
    "promise",
    "titles",
    "disclosure",
    "control",
    "scenes"
  ],
  "title": "Script",
  "type": "object"
}
